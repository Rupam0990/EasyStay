<% layout('/layouts/boilerplate') -%>
        <div class="row mt-3">
                <div class="col-8 offset-2">

                        <br>
                        <h3>Create a new Listing</h3>

                        <form action="/listings" method="post" novalidate class="needs-validation" enctype="multipart/form-data">
                                <div class="mb-3">
                                        <label for="title" class="fom-label">Title</label>
                                        <input type="text" class="form-control" id="title"
                                                placeholder="Add a Catchy title" name="listing[title]" required>
                                        <div class="valid-feedback">
                                                Title Looks good!
                                        </div>
                                        <div class="invalid-feedback">
                                                Please enter a valid title !
                                        </div>

                                </div>
                                <div class="mb-3">
                                        <label for="des" class="fom-label">Description</label>
                                        <textarea name="listing[description]" class="form-control" id="des"
                                                required></textarea>
                                        <div class="valid-feedback">
                                                Description Looks good!
                                        </div>
                                        <div class="invalid-feedback">
                                                Please enter a short Description !
                                        </div>
                                </div>
                                <div class="mb-3">
                                        <label for="img" class="fom-label">Upload Image </label>
                                        <input type="file" class="form-control" name="listing[image]" id="img">
                                             
                                </div>
                                <div class="row">
                                        <div class="mb-3 col-md-6">
                                                <label for="price" class="fom-label">Price</label>
                                                <input type="number" class="form-control" name="listing[price]"
                                                        id="price" placeholder="1000" required>
                                                <div class="invalid-feedback">
                                                        Please enter a valid price !
                                                </div>
                                        </div>
                                        <div class="mb-3 col-md-6">
                                                <label for="cou" class="fom-label">Country</label>
                                                <input type="text" class="form-control" name="listing[country]" id="cou"
                                                        placeholder="india" required>
                                                <div class="invalid-feedback">
                                                        Please enter Country !
                                                </div>
                                        </div>
                                </div>

                                <div class="mb-3">
                                        <label for="category" class="fom-label">Category</label>
                                        <select class="form-select" name="listing[category]" id="category">
                                                <option value="trending">Trending</option>
                                                <option value="rooms">Rooms</option>
                                                <option value="iconic-cities">Iconic Cities</option>
                                                <option value="cabins">Cabins</option>
                                                <option value="amazing-pools">Amazing Pools</option>
                                                <option value="camping">Camping</option>
                                                <option value="farms">Farms</option>
                                                <option value="arctic">Arctic</option>
                                                <option value="dome">Dome</option>
                                                <option value="boats">Boats</option>
                                        </select>
                                </div>

                                <div class="mb-3">
                                        <label for="location" class="fom-label">Location</label>
                                        <input type="text" class="form-control" name="listing[location]"
                                                id="location" placeholder="Jaipur, Rajasthan" required>
                                        <div class="invalid-feedback">
                                                Please enter Location !
                                        </div>
                                </div>
                                <br>
                                <button class="btn btn-dark add-btn ">Add</button>
                                <br><br>
                        </form>
                </div>


        </div>