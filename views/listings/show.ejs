<% layout('/layouts/boilerplate') -%>

    <script>
        const mapToken = "<%= process.env.MAP_TOKEN %>";
        const listingCoordinates = JSON.parse('<%= JSON.stringify(place && place.geometry && place.geometry.coordinates ? place.geometry.coordinates : [77.2089, 28.6139]) %>');
        const listingTitle = "<%= place.title %>";
        const listingLocation = "<%= place.location %>";
        const basePrice = Number("<%= place.price != null ? place.price : 0 %>");
    </script>
    <div class="row mt-3">
        <div class="col-8 offset-3">
            <b>
                <%= place.title %>
            </b>
        </div>

        <div class="card col-6 offset-3 mt-2 show-card">
            <img src="<%= place.image.url %>" class="card-img-top show-img" alt="Listing_img">
            <div class="card-body mt-3">
                <p class="card-text">
                    <small class="text-muted">Hosted by <strong>
                            <%= place.owner && place.owner.username ? place.owner.username : "Unknown" %>
                        </strong></small><br>
                    <%= place.description %><br>
                        <span id="show-price">₹ <%= place.price.toLocaleString("en-IN") %></span><br>
                            <%= place.location %>,
                                <%= place.country %>
                </p>
                <% if (currentUser && place.owner && String(place.owner._id || place.owner)===String(currentUser._id)) {
                    %>
                    <div class="d-flex gap-2 mt-3">
                        <a href="/listings/<%= place._id %>/edit" class="btn btn-dark add-btn">Edit</a>

                        <form action="/listings/<%= place._id %>?_method=DELETE" method="post">
                            <button class="btn btn-dark">Delete</button>
                        </form>

                    </div>
                    <% } %>

            </div>
            <hr>
        </div>

        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const showPrice = document.getElementById('show-price');
                const shouldApplyTax = localStorage.getItem('displayTotalAfterTaxes') === 'true';

                if (showPrice) {
                    const finalPrice = shouldApplyTax ? Math.round(basePrice * 1.18) : basePrice;
                    showPrice.textContent = `₹ ${finalPrice.toLocaleString('en-IN')}`;
                }
            });
        </script>



        <!-- Review Form -->
        <div class="card col-6 offset-3  mb-4">
            <div class="card-body pb-2">
                <h5 class="card-title mb-2">Leave a Review</h5>

                <form action="/listings/<%= place._id %>/reviews" method="post" novalidate class="needs-validation">

                    <!-- Rating -->
                    
                        <fieldset class="starability-slot">
                           
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0"
                                checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    


                    <!-- Review Comment -->
                    <div class="mb-3">
                        <label for="comment" class="form-label">Review</label>
                        <textarea class="form-control" id="comment" name="review[comment]" rows="3"
                            placeholder="Share your experience..." required></textarea>
                        <div class="invalid-feedback">
                            Please write a review!
                        </div>
                    </div>

                    <button class="btn btn-dark add-btn">Submit Review</button>
                </form>
            </div>
            <% if (place.reviews && place.reviews.length > 0) { %>
                <hr class="mt-2 mb-3" />
                <h4 class="mb-3 mt-0">All Reviews</h4>

                <div class="row">
                    <% for(let review of place.reviews) { %>
                        <div class="col-md-6 mb-3">
                            <div class="card border-0 shadow-sm h-100 review-card">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <strong class="text-dark">
                                            <%= review.author && review.author.username ? review.author.username
                                                : "Unknown User" %>
                                        </strong>
                                        <span class="text-muted small">
                                            <%= new Date(review.createdAt).toLocaleDateString("en-IN", {
                                                day: "numeric",
                                                month: "short",
                                                year: "numeric"
                                            }) %>
                                        </span>
                                    </div>

                                    <div class="mb-2">
                                        <p class="starability-result" data-rating="<%= review.rating %>">
                                            Rated: <%= review.rating %> star<%= review.rating===1 ? "" : "s" %>
                                        </p>
                                    </div>

                                    <p class="card-text text-secondary mb-3">
                                        <%= review.comment %>
                                    </p>

                                    <% if (currentUser && review.author && String(review.author._id ||
                                        review.author)===String(currentUser._id)) { %>
                                        <form
                                            action="/listings/<%= place._id %>/reviews/<%= review._id %>?_method=DELETE"
                                            method="post" class="mt-auto">
                                            <button class="btn btn-sm btn-danger blk">Delete</button>
                                        </form>
                                        <% } %>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
                <hr>
            <% } %>
            
        </div>
        <div class="card col-6 offset-3 mt-2 mb-4 p-0">
            <div class="card-body p-3">
                <h3 class="text-start mb-3">where you'll be</h3>
                <div id="map" style="width: 100%; height: 360px; border-radius: 12px; overflow: hidden;"></div>
            </div>
        </div>

    </div>

    <script src="/js/map.js"></script>